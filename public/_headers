# Cloudflare reads this at deploy. Vite names the files in /assets by their content, so they never
# change under a name and can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images and the font keep their names when they change, so browsers use their copy for a day and
# then fetch the new one in the background.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
